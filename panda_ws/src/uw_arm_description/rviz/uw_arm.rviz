Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /RobotModel1
        - /TF1
      Splitter Ratio: 0.5
    Tree Height: 640
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
      Color: 100; 120; 130
      Reference Frame: base_link
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.15
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Frames:
        All Enabled: true
    - Class: rviz_default_plugins/Image
      Name: WristRGB
      Enabled: true
      Topic:
        Value: /wrist_camera/image
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/PointCloud2
      Name: WristCloud
      Enabled: false
      Topic:
        Value: /wrist_camera/points
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Size (m): 0.005
      Style: Points
      Color Transformer: RGB8
  Global Options:
    Background Color: 20; 40; 50
    Fixed Frame: base_link
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 2.0
      Focal Point: {X: 0.15, Y: -0.15, Z: 0.35}
      Pitch: 0.4
      Yaw: 5.4
      Target Frame: base_link
Window Geometry:
  Height: 900
  Width: 1500
  Displays: {collapsed: false}
